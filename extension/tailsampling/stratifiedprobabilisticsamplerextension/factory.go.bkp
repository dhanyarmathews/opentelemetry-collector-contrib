func init() {
	// Initialize Type with component.NewType, handle error
	var err error
	Type, err = component.NewType(PolicyTypeStr)
	if err != nil {
		log.Fatalf("Failed to create component type: %v", err)
	}

	// You can also define the stability level here as needed
	ExtensionStability = component.StabilityLevelAlpha
	// Register the policy factory for tail-sampling processor
	// ext := &StratifiedProbabilisticExtension{} // default instance
	//samplingpolicy.RegisterPolicy(PolicyTypeStr, NewStratifiedPolicyFactory(ext))
}

func NewFactory() extension.Factory {
	return extension.NewFactory(
		Type,
		createDefaultConfig,
		createExtension,
		ExtensionStability,
	)
}

/*func createDefaultConfig() component.Config {
	return &Config{}
}*/

func createExtension(_ context.Context, settings extension.Settings, cfg component.Config) (extension.Extension, error) {
	eCfg := cfg.(*Config)
	extensionInstance, err := NewExtension(settings, eCfg)

	// If there is an error, return the error
	if err != nil {
		return nil, err
	}

	// Otherwise, return the extension instance
	return extensionInstance, nil
	//return NewStratifiedProbabilisticExtension(settings, eCfg), nil
}

